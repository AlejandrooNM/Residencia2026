# Copia este archivo como .env y ajusta los valores

ENTORNO=desarrollo
DEPURACION=true

# API
HOST_API=127.0.0.1
PUERTO_API=8000

# Base de datos (ruta relativa a la raíz del proyecto)
URL_BASE_DE_DATOS=sqlite:///./base_de_datos/sistema_iam.db

# Rutas de datos y modelo
RUTA_DATASET=./dataset
RUTA_MODELO=./modelo_ia/puntos_control
RUTA_CARGAS=./cargas/ecg

# Umbral de clasificación (ajustable tras validación)
UMBRAL_CLASIFICACION=0.5
