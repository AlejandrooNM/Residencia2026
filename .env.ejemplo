# Copia este archivo como .env y ajusta los valores

ENTORNO=desarrollo
DEPURACION=true

# API
HOST_API=127.0.0.1
PUERTO_API=8000

# true = acceso en red local / demos compartidas
MODO_COMPARTIR=false

# Base de datos (ruta relativa a la raíz del proyecto)
URL_BASE_DE_DATOS=sqlite:///./base_de_datos/sistema_iam.db

# Rutas de datos y modelo
RUTA_DATASET=./dataset
RUTA_MODELO=./modelo_ia/puntos_control
RUTA_CARGAS=./cargas/ecg

# Modelo entrenado usado por la web (no se sube a git; compártelo aparte)
RUTA_CHECKPOINT=./modelo_ia/puntos_control/resnet1d_estandar_100hz/mejor.pt
VARIANTE_MODELO=estandar

# Umbral de clasificación elegido en validación (scripts/evaluar_modelo.py)
UMBRAL_CLASIFICACION=0.3204

# Modelo y umbral para ECG impresos (PDF, escaneo o foto en formato 3 x 4)
# (scripts/evaluar_digitalizacion.py --conjunto validacion)
RUTA_CHECKPOINT_IMPRESO=./modelo_ia/puntos_control/resnet1d_estandar_impreso_digitalizado_100hz/mejor.pt
UMBRAL_CLASIFICACION_IMPRESO=0.3623
TAMANO_MAXIMO_CARGA_MB=20
